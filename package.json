{
  "name": "lol-randomizer",
  "private": true,
  "version": "2.0.0",
  "description": "Desktopový randomizer rolí a šampionů pro League of Legends",
  "license": "MIT",
  "author": {
    "name": "AdamKala",
    "email": "AdamKala@users.noreply.github.com"
  },
  "repository": "https://github.com/AdamKala/lol-randomizer",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tauri.mjs dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "tsc -b && vite build",
    "build": "node scripts/run-tauri.mjs build",
    "dist:win": "node scripts/run-tauri.mjs build --bundles nsis --target x86_64-pc-windows-msvc && node scripts/collect-tauri-artifacts.mjs nsis",
    "dist:linux": "node scripts/run-tauri.mjs build --bundles appimage,deb && node scripts/collect-tauri-artifacts.mjs appimage && node scripts/collect-tauri-artifacts.mjs deb",
    "dist:mac": "node scripts/run-tauri.mjs build --bundles dmg && node scripts/collect-tauri-artifacts.mjs dmg",
    "assets:download": "node scripts/download-champion-icons.mjs",
    "meta:refresh-opgg": "node scripts/refresh-champion-stats.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.5"
  }
}
